# name: test/sql/duckboost/lgb_categorical.test
# description: LightGBM categorical bitsets import as set-membership splits
# group: [duckboost]

require duckboost

statement ok
CREATE TABLE lgb_categorical_model AS
SELECT duckboost_import(
	'lightgbm',
	(SELECT content FROM read_text('test/sql/duckboost/data/lgb_categorical.txt'))
) AS model;

# LightGBM sends category matches left; the imported IN node swaps children.
query IIIIIIII
SELECT
	duckboost_predict(model, [1.0, 1.0]),
	duckboost_predict(model, [3.0, 6.0]),
	duckboost_predict(model, [1.0, NULL]),
	duckboost_predict(model, [2.0, 1.0]),
	duckboost_predict(model, [NULL, 1.0]),
	duckboost_predict(model, [-1.0, 1.0]),
	duckboost_predict(model, [99.0, 1.0]),
	duckboost_predict(model, [3.0, 5.0])
FROM lgb_categorical_model;
----
200.0	300.0	200.0	100.0	100.0	100.0	100.0	200.0

query I
SELECT model LIKE '%"compare":"in","categories":[1,3],"default_left":true%'
FROM lgb_categorical_model;
----
true

# The "set" JSON alias is accepted, sorted, and deduplicated on import.
statement ok
CREATE TABLE lgb_set_alias AS
SELECT duckboost_import(
	'reference',
	replace(
		model,
		'"compare":"in","categories":[1,3]',
		'"compare":"set","categories":[3,1,3]'
	)
) AS model
FROM lgb_categorical_model;

query II
SELECT
	model LIKE '%"compare":"in","categories":[1,3]%',
	duckboost_predict(model, [3.0, 6.0])
FROM lgb_set_alias;
----
true	300.0

# Unknown comparison strings must never silently become numerical LESS nodes.
statement error
SELECT duckboost_import(
	'reference',
	replace(model, '"compare":"in"', '"compare":"mystery"')
)
FROM lgb_categorical_model;
----
unknown split compare 'mystery'

statement ok
CREATE TABLE lgb_categorical_score(id, category, amount) AS
VALUES
	(1, 1.0, 1.0),
	(2, 3.0, 6.0),
	(3, 1.0, NULL::DOUBLE),
	(4, 2.0, 1.0),
	(5, NULL::DOUBLE, 1.0),
	(6, -1.0, 1.0),
	(7, 99.0, 1.0);

statement ok
CREATE TABLE lgb_categorical_native AS
SELECT id, duckboost_predict(model, [category, amount]) AS prediction
FROM lgb_categorical_model, lgb_categorical_score;

statement ok
CREATE TABLE lgb_categorical_sql AS
SELECT duckboost_to_sql(
	model,
	'lgb_categorical_score',
	['category', 'amount'],
	MAP {'separate_trees': 'false', 'prediction_alias': 'prediction'}
) AS sql
FROM lgb_categorical_model;

query I
SELECT sql LIKE '%"category" IN (1,3)%'
FROM lgb_categorical_sql;
----
true

statement ok
SET VARIABLE lgb_categorical_query = (SELECT sql FROM lgb_categorical_sql);

statement ok
CREATE TABLE lgb_categorical_exported AS
SELECT prediction::DOUBLE AS prediction
FROM query(getvariable('lgb_categorical_query'));

query I
SELECT
	(SELECT list(round(prediction, 12) ORDER BY prediction) FROM lgb_categorical_native)
	=
	(SELECT list(round(prediction, 12) ORDER BY prediction) FROM lgb_categorical_exported);
----
true

# Native JSON round-trip preserves categories and branch routing.
statement ok
CREATE TABLE lgb_categorical_roundtrip AS
SELECT duckboost_import('reference', model) AS model
FROM lgb_categorical_model;

query III
SELECT
	duckboost_predict(model, [1.0, 1.0]),
	duckboost_predict(model, [2.0, 1.0]),
	duckboost_predict(model, [NULL, 1.0])
FROM lgb_categorical_roundtrip;
----
200.0	100.0	100.0

# A one-category bitset stays compatible with trained one-vs-rest EQUAL nodes.
statement ok
CREATE TABLE lgb_categorical_single AS
SELECT duckboost_import(
	'lightgbm',
	(SELECT content FROM read_text('test/sql/duckboost/data/lgb_categorical_single.txt'))
) AS model;

query III
SELECT
	model LIKE '%"compare":"equal"%',
	duckboost_predict(model, [4.0]),
	duckboost_predict(model, [5.0])
FROM lgb_categorical_single;
----
true	8.0	9.0

# Generated by LightGBM 4.7.0 with learning_rate=0.2. Expected values
# come directly from Booster.predict for all eight integer categories.
statement ok
CREATE TABLE lgb_real_categorical AS
SELECT duckboost_import(
	'lightgbm',
	(SELECT content FROM read_text('test/sql/duckboost/data/lgb_real_categorical.txt'))
) AS model;

query I
SELECT count(*) = 8
	AND bool_and(abs(duckboost_predict(model, [category]) - expected) < 1e-9)
FROM lgb_real_categorical,
	(VALUES
		(0.0, -0.7253333330154419),
		(1.0, -0.42133331298828125),
		(2.0, 0.2986666679382325),
		(3.0, 0.5824000000953675),
		(4.0, 3.4175999999046325),
		(5.0, 3.7013333320617674),
		(6.0, 4.421333312988281),
		(7.0, 4.725333333015442)
	) probes(category, expected);
----
true

# Categorical metadata is validated before tree conversion.
statement error
SELECT duckboost_import(
	'lightgbm',
	replace(
		(SELECT content FROM read_text('test/sql/duckboost/data/lgb_categorical.txt')),
		'cat_boundaries=0 1',
		'cat_boundaries=0 2'
	)
);
----
<REGEX>:.*cat_boundaries.*

statement error
SELECT duckboost_import(
	'lightgbm',
	replace(
		(SELECT content FROM read_text('test/sql/duckboost/data/lgb_categorical.txt')),
		'num_cat=1',
		'num_cat=2'
	)
);
----
<REGEX>:.*(num_cat|cat_boundaries).*
