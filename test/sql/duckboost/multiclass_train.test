# name: test/sql/duckboost/multiclass_train.test
# description: reference trainer multiclass (softmax) train / predict / proba / evaluate / to_sql
# group: [duckboost]

require duckboost

statement ok
CREATE TABLE iris AS
SELECT
	row_number() OVER () AS rn,
	sepal_length, sepal_width, petal_length, petal_width,
	CASE species WHEN 'setosa' THEN 0 WHEN 'versicolor' THEN 1 ELSE 2 END::DOUBLE AS label,
	[sepal_length, sepal_width, petal_length, petal_width] AS features
FROM read_csv('data/iris.csv');

statement ok
CREATE TABLE models AS
SELECT duckboost_train(
	label, features,
	MAP {'task': 'multiclass', 'n_estimators': '20', 'max_depth': '2', 'learning_rate': '0.3'}
) AS model
FROM iris;

# n_classes inferred from labels, one tree per class per round, log-prior biases (balanced classes)
query III
SELECT
	model LIKE '%"task":"multiclass"%',
	model LIKE '%"n_classes":3%',
	(length(model) - length(replace(model, '"nodes"', ''))) // length('"nodes"')
FROM models;
----
true	true	60

query I
SELECT model LIKE '%"base_scores":[-1.0986122886681098,-1.0986122886681098,-1.0986122886681098]%' FROM models;
----
true

query I
SELECT duckboost_evaluate_agg(model, label, features, MAP {'metric': 'accuracy'}) >= 0.98 FROM models, iris;
----
true

query I
SELECT duckboost_evaluate_agg(model, label, features, MAP {'metric': 'logloss'}) < 0.1 FROM models, iris;
----
true

# predict returns the class index; predict_proba has one probability per class summing to 1
query II
SELECT
	count(*) FILTER (WHERE duckboost_predict(model, features) NOT IN (0, 1, 2)),
	count(*) FILTER (WHERE len(duckboost_predict_proba(model, features)) <> 3
	                    OR abs(list_sum(duckboost_predict_proba(model, features)) - 1) > 1e-9)
FROM models, iris;
----
0	0

# predict is the argmax of predict_proba
query I
SELECT count(*) FILTER (
	WHERE duckboost_predict(model, features) + 1 <> list_position(
		duckboost_predict_proba(model, features), list_max(duckboost_predict_proba(model, features)))
)
FROM models, iris;
----
0

# Training is deterministic
query I
SELECT count(DISTINCT model) FROM (
	SELECT duckboost_train(label, features, MAP {'task': 'multiclass', 'n_estimators': '5'}) AS model FROM iris
	UNION ALL
	SELECT duckboost_train(label, features, MAP {'task': 'multiclass', 'n_estimators': '5'}) FROM iris
);
----
1

# Exported SQL reproduces duckboost_predict
statement ok
CREATE TABLE iris_flat AS SELECT rn, sepal_length, sepal_width, petal_length, petal_width FROM iris ORDER BY rn;

statement ok
SET VARIABLE mc_sql = (
	SELECT duckboost_to_sql(model, 'iris_flat', ['sepal_length', 'sepal_width', 'petal_length', 'petal_width'],
	                        MAP {'separate_trees': 'true', 'prediction_alias': 'pred'})
	FROM models
);

statement ok
CREATE TABLE sql_preds AS SELECT row_number() OVER () AS rn, pred FROM query(getvariable('mc_sql'));

query II
SELECT count(*), count(*) FILTER (WHERE s.pred = duckboost_predict(m.model, [f.sepal_length, f.sepal_width, f.petal_length, f.petal_width]))
FROM sql_preds s JOIN iris_flat f USING (rn), models m;
----
150	150

# Holdout: every fifth row per class
statement ok
CREATE TABLE split AS
SELECT *, row_number() OVER (PARTITION BY label ORDER BY rn) % 5 = 0 AS is_test FROM iris;

query I
SELECT duckboost_evaluate_agg(m.model, label, features, MAP {'metric': 'accuracy'}) >= 0.9
FROM (SELECT duckboost_train(label, features, MAP {'task': 'multiclass', 'n_estimators': '30', 'max_depth': '2'}) AS model
      FROM split WHERE NOT is_test) m, split
WHERE is_test;
----
true

# n_classes override keeps an unseen class (index 3) with a tiny prior
query II
SELECT model LIKE '%"n_classes":4%', (length(model) - length(replace(model, '"nodes"', ''))) // length('"nodes"')
FROM (SELECT duckboost_train(label, features, MAP {'task': 'multiclass', 'n_classes': '4', 'n_estimators': '2'}) AS model FROM iris);
----
true	8

query I
SELECT list_last(duckboost_predict_proba(model, [5.1, 3.5, 1.4, 0.2])) < 1e-3
FROM (SELECT duckboost_train(label, features, MAP {'task': 'multiclass', 'n_classes': '4', 'n_estimators': '2'}) AS model FROM iris);
----
true

# Label validation
statement error
SELECT duckboost_train(label + 0.5, features, MAP {'task': 'multiclass'}) FROM iris;
----
multiclass labels must be integer class indices

statement error
SELECT duckboost_train(-1::DOUBLE, features, MAP {'task': 'multiclass'}) FROM iris;
----
multiclass labels must be integer class indices

statement error
SELECT duckboost_train(label, features, MAP {'task': 'multiclass', 'n_classes': '2'}) FROM iris;
----
out of range for n_classes = 2

statement error
SELECT duckboost_train(0::DOUBLE, features, MAP {'task': 'multiclass'}) FROM iris;
----
requires at least 2 classes

statement error
SELECT duckboost_train(label, features, MAP {'task': 'multiclass', 'n_classes': '1'}) FROM iris;
----
n_classes must be >= 2

# Penguins species (Adelie / Chinstrap / Gentoo) from measurements
statement ok
CREATE TABLE penguins AS
SELECT
	CASE species WHEN 'Adelie' THEN 0 WHEN 'Chinstrap' THEN 1 ELSE 2 END::DOUBLE AS label,
	[bill_length_mm, bill_depth_mm, flipper_length_mm, body_mass_g] AS features
FROM read_csv('data/penguins.csv', nullstr = 'NA')
WHERE bill_length_mm IS NOT NULL;

query I
SELECT duckboost_evaluate_agg(model, label, features, MAP {'metric': 'accuracy'}) > 0.95
FROM (SELECT duckboost_train(label, features, MAP {'task': 'multiclass', 'n_estimators': '20', 'max_depth': '3'}) AS model FROM penguins), penguins;
----
true

# Regression and binary tasks are unchanged by n_classes being unset
query I
SELECT model LIKE '%"n_classes":1%' FROM (SELECT duckboost_train(sepal_length, [petal_length], MAP {'n_estimators': '2'}) AS model FROM iris);
----
true
