# name: test/sql/duckboost/category_cast.test
# description: EQUAL/IN category_cast semantics for LightGBM and XGBoost
# group: [duckboost]

require duckboost

statement ok
CREATE TABLE cast_exact AS
SELECT duckboost_import(
	'reference',
	'{"duckboost_version":2,"backend":"reference","task":"regression","base_score":0,"learning_rate":1,"n_features":1,"n_classes":1,"feature_names":["f0"],"trees":[{"nodes":[{"is_leaf":false,"feature":0,"threshold":0,"left":1,"right":2,"value":0,"compare":"in","categories":[1,3],"default_left":true},{"is_leaf":true,"feature":0,"threshold":0,"left":0,"right":0,"value":100},{"is_leaf":true,"feature":0,"threshold":0,"left":0,"right":0,"value":200}]}]}'
) AS model;

statement ok
CREATE TABLE cast_lgb AS
SELECT duckboost_import(
	'reference',
	replace(model, '"default_left":true', '"default_left":true,"category_cast":"lightgbm"')
) AS model
FROM cast_exact;

statement ok
CREATE TABLE cast_xgb AS
SELECT duckboost_import(
	'reference',
	replace(model, '"default_left":true', '"default_left":true,"category_cast":"xgboost"')
) AS model
FROM cast_exact;

# EXACT: only exact membership; 1.7 and -0.5 miss.
query IIIIII
SELECT
	duckboost_predict(model, [1.0]),
	duckboost_predict(model, [1.7]),
	duckboost_predict(model, [3.9999]),
	duckboost_predict(model, [-0.5]),
	duckboost_predict(model, [-0.99]),
	duckboost_predict(model, [NULL])
FROM cast_exact;
----
200.0	100.0	100.0	100.0	100.0	100.0

# LIGHTGBM: trunc() membership; -0.5 truncates to -0, which equals 0 and still misses {1,3}.
query IIIIII
SELECT
	duckboost_predict(model, [1.0]),
	duckboost_predict(model, [1.7]),
	duckboost_predict(model, [3.9999]),
	duckboost_predict(model, [-0.5]),
	duckboost_predict(model, [-1.0]),
	duckboost_predict(model, [NULL])
FROM cast_lgb;
----
200.0	200.0	200.0	100.0	100.0	100.0

# XGBOOST: trunc() for value >= 0 only; negatives never match.
query IIIIII
SELECT
	duckboost_predict(model, [1.0]),
	duckboost_predict(model, [1.7]),
	duckboost_predict(model, [3.9999]),
	duckboost_predict(model, [-0.5]),
	duckboost_predict(model, [-1.0]),
	duckboost_predict(model, [NULL])
FROM cast_xgb;
----
200.0	200.0	200.0	100.0	100.0	100.0

# SQL export uses trunc() for vendor casts and agrees with predict.
statement ok
CREATE TABLE cast_rows(id, f0) AS
VALUES (1, 1.7), (2, 3.9999), (3, -0.5), (4, NULL::DOUBLE);

statement ok
SET VARIABLE lgb_sql = (
	SELECT duckboost_to_sql(model, 'cast_rows', ['f0'], MAP {
		'separate_trees': 'false',
		'prediction_alias': 'pred',
		'keep_columns': 'id'
	})
	FROM cast_lgb
);

query I
SELECT getvariable('lgb_sql') ILIKE '%trunc("f0") IN (1,3)%';
----
true

statement ok
CREATE TABLE lgb_sql_pred AS SELECT * FROM query(getvariable('lgb_sql'));

query I
SELECT bool_and(abs(n.pred - s.pred) < 1e-12)
FROM (
	SELECT id, duckboost_predict(model, [f0]) AS pred FROM cast_lgb, cast_rows
) n
JOIN lgb_sql_pred s USING (id);
----
true

statement ok
SET VARIABLE xgb_sql = (
	SELECT duckboost_to_sql(model, 'cast_rows', ['f0'], MAP {
		'separate_trees': 'false',
		'prediction_alias': 'pred'
	})
	FROM cast_xgb
);

query I
SELECT getvariable('xgb_sql') ILIKE '%f0" >= 0 AND trunc("f0") IN (1,3)%';
----
true

statement error
SELECT duckboost_import(
	'reference',
	replace(model, '"default_left":true', '"default_left":true,"category_cast":"mystery"')
)
FROM cast_exact;
----
<REGEX>:.*unknown category_cast 'mystery'.*

statement error
SELECT duckboost_import(
	'reference',
	'{"duckboost_version":2,"backend":"reference","task":"regression","base_score":0,"learning_rate":1,"n_features":1,"n_classes":1,"feature_names":["f0"],"trees":[{"nodes":[{"is_leaf":false,"feature":0,"threshold":1.5,"left":1,"right":2,"value":0,"default_left":true,"category_cast":"lightgbm"},{"is_leaf":true,"feature":0,"threshold":0,"left":0,"right":0,"value":1},{"is_leaf":true,"feature":0,"threshold":0,"left":0,"right":0,"value":2}]}]}'
);
----
<REGEX>:.*category_cast is only valid on equal/in nodes.*
