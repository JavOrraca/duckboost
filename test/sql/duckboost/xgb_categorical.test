# name: test/sql/duckboost/xgb_categorical.test
# description: XGBoost categorical IN/EQUAL import with category_cast=xgboost
# group: [duckboost]

require duckboost

statement ok
CREATE TABLE xgb_cat_models AS
SELECT duckboost_import(
	'xgboost',
	'[
	  {
	    "nodeid": 0,
	    "depth": 0,
	    "split": "f0",
	    "split_condition": [1, 3],
	    "yes": 1,
	    "no": 2,
	    "missing": 2,
	    "children": [
	      {"nodeid": 1, "leaf": 200.0},
	      {"nodeid": 2, "leaf": 100.0}
	    ]
	  }
	]',
	MAP {'task': 'regression', 'base_score': '0.0'}
) AS model;

query I
SELECT model LIKE '%"category_cast":"xgboost"%' AND model LIKE '%"compare":"in"%'
FROM xgb_cat_models;
----
true

query IIIIIII
SELECT
	duckboost_predict(model, [1.0]),
	duckboost_predict(model, [1.7]),
	duckboost_predict(model, [3.0]),
	duckboost_predict(model, [2.0]),
	duckboost_predict(model, [-0.5]),
	duckboost_predict(model, [NULL]),
	duckboost_predict(model, [99.0])
FROM xgb_cat_models;
----
200.0	200.0	200.0	100.0	100.0	100.0	100.0

statement ok
CREATE TABLE xgb_cat_rows(id, f0) AS
VALUES (1, 1.7), (2, -0.5), (3, 3.0), (4, NULL::DOUBLE);

statement ok
SET VARIABLE xgb_cat_sql = (
	SELECT duckboost_to_sql(model, 'xgb_cat_rows', ['f0'], MAP {
		'separate_trees': 'false',
		'prediction_alias': 'pred',
		'keep_columns': 'id'
	})
	FROM xgb_cat_models
);

query I
SELECT getvariable('xgb_cat_sql') ILIKE '%f0" >= 0 AND trunc("f0") IN (1,3)%';
----
true

statement ok
CREATE TABLE xgb_cat_sql_pred AS SELECT * FROM query(getvariable('xgb_cat_sql'));

query I
SELECT bool_and(abs(n.pred - s.pred) < 1e-12)
FROM (
	SELECT id, duckboost_predict(model, [f0]) AS pred FROM xgb_cat_models, xgb_cat_rows
) n
JOIN xgb_cat_sql_pred s USING (id);
----
true

# Unknown dump fields and named features without feature_names fail loudly.
statement error
SELECT duckboost_import('xgboost', '[{"nodeid":0,"leaf":1.0,"extra":true}]');
----
<REGEX>:.*unknown xgboost dump field 'extra'.*

statement error
SELECT duckboost_import(
	'xgboost',
	'[{"nodeid":0,"depth":0,"split":"amount","split_condition":1.5,"yes":1,"no":2,"missing":1,"children":[{"nodeid":1,"leaf":0.5},{"nodeid":2,"leaf":-0.25}]}]'
);
----
<REGEX>:.*dump uses feature names; pass feature_names.*

statement ok
SELECT duckboost_import(
	'xgboost',
	'[{"nodeid":0,"depth":0,"split":"amount","split_condition":1.5,"yes":1,"no":2,"missing":1,"children":[{"nodeid":1,"leaf":0.5},{"nodeid":2,"leaf":-0.25}]}]',
	MAP {'feature_names': 'amount'}
);
