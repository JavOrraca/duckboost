# name: test/sql/duckboost/calibrated_interval.test
# description: Exact split-conformal rank, crossing, persistence and SQL parity
# group: [duckboost]

load {TEST_DIR}/duckboost_interval.db

require duckboost

statement ok
CREATE TABLE fits AS
SELECT
	duckboost_train(0, [0.0], MAP {'objective':'quantile', 'quantile_alpha':'0.05'}) AS lo,
	duckboost_train(0, [0.0], MAP {'objective':'quantile', 'quantile_alpha':'0.5'}) AS med,
	duckboost_train(0, [0.0], MAP {'objective':'quantile', 'quantile_alpha':'0.95'}) AS hi;

statement ok
CREATE TABLE artifacts AS
SELECT duckboost_calibrate_interval(lo, med, hi, 0.1, i, [0.0]) AS model
FROM fits, range(1, 11) t(i);

# At 90% target coverage the one-based rank is ceil(11 * .9) = 10.
query III
SELECT model LIKE '%"correction":10,%', model LIKE '%"n_calibration":10,%',
	model LIKE '%"duckboost_version":3,%' FROM artifacts;
----
true	true	true

statement error
SELECT duckboost_calibrate_interval(lo, med, hi, 0.05, i, [0.0]) FROM fits, range(1, 11) t(i);
----
insufficient calibration rows

statement error
SELECT duckboost_calibrate_interval(lo, med, hi, 0.1, i, [0.0]) FROM fits, range(0) t(i);
----
insufficient calibration rows

statement error
SELECT duckboost_calibrate_interval(hi, med, lo, 0.1, i, [0.0]) FROM fits, range(10) t(i);
----
expected lower, median

statement error
SELECT duckboost_calibrate_interval(lo, med, hi, i / 100.0, i, [0.0]) FROM fits, range(1, 11) t(i);
----
constant within a calibration group

statement error
SELECT duckboost_calibrate_interval(lo, med, hi, 'NaN'::DOUBLE, i, [0.0]) FROM fits, range(10) t(i);
----
alpha must be strictly between

statement error
SELECT duckboost_calibrate_interval(lo, med, hi, 0.1, 'NaN'::DOUBLE, [0.0]) FROM fits;
----
calibration targets and scores must be finite

# Force crossing by fitting separate constants. Predictions (5,10,2) sort to
# (2,5,10); y=3 gives a signed correction of -1 and a final band [3,9].
statement ok
CREATE TABLE crossed AS
WITH q AS (
	SELECT duckboost_train(5, [0.0], MAP {'objective':'quantile', 'quantile_alpha':'0.05'}) AS lo,
	       duckboost_train(10, [0.0], MAP {'objective':'quantile', 'quantile_alpha':'0.5'}) AS med,
	       duckboost_train(2, [0.0], MAP {'objective':'quantile', 'quantile_alpha':'0.95'}) AS hi
)
SELECT duckboost_calibrate_interval(lo, med, hi, 0.1, 3, [1.0]) AS model FROM q, range(10);

restart

require duckboost

query RRR
SELECT b.lower, b.median, b.upper FROM
(SELECT duckboost_predict_interval(model, [2.0]) AS b FROM artifacts);
----
-10.0	0.0	10.0

query RRR
SELECT b.lower, b.median, b.upper FROM
(SELECT duckboost_predict_interval(model, [2.0]) AS b FROM crossed);
----
3.0	5.0	9.0

statement ok
CREATE TABLE probes AS SELECT i AS id, i % 3 AS x FROM range(1, 6) t(i)
UNION ALL SELECT 0, NULL;

statement ok
SET VARIABLE interval_sql = (SELECT duckboost_interval_to_sql(model, 'probes', ['x'], ['id']) FROM crossed);

query I
WITH actual AS (SELECT * FROM query(getvariable('interval_sql'))),
expected AS (SELECT id, duckboost_predict_interval(model, [x]) AS b FROM probes, crossed)
SELECT count(*) = 6 AND bool_and(actual.lower = b.lower AND actual.median = b.median AND actual.upper = b.upper)
FROM actual JOIN expected USING (id);
----
true
