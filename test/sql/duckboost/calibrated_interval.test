# name: test/sql/duckboost/calibrated_interval.test
# description: Exact split-conformal rank, crossing, persistence and SQL parity
# group: [duckboost]

load {TEST_DIR}/duckboost_interval.db

require duckboost

statement ok
CREATE TABLE fits AS
SELECT
	duckboost_train(0, [0.0], MAP {'objective':'quantile', 'quantile_alpha':'0.05'}) AS lo,
	duckboost_train(0, [0.0], MAP {'objective':'quantile', 'quantile_alpha':'0.5'}) AS med,
	duckboost_train(0, [0.0], MAP {'objective':'quantile', 'quantile_alpha':'0.95'}) AS hi;

statement ok
CREATE TABLE artifacts AS
SELECT duckboost_calibrate_interval(lo, med, hi, 0.1, i, [0.0]) AS model
FROM fits, range(1, 11) t(i);

# At 90% target coverage the one-based rank is ceil(11 * .9) = 10.
query III
SELECT model LIKE '%"correction":10,%', model LIKE '%"n_calibration":10,%',
	model LIKE '%"duckboost_version":3,%' FROM artifacts;
----
true	true	true

statement error
SELECT duckboost_calibrate_interval(lo, med, hi, 0.05, i, [0.0]) FROM fits, range(1, 11) t(i);
----
insufficient calibration rows

statement error
SELECT duckboost_calibrate_interval(lo, med, hi, 0.1, i, [0.0]) FROM fits, range(0) t(i);
----
insufficient calibration rows

statement error
SELECT duckboost_calibrate_interval(hi, med, lo, 0.1, i, [0.0]) FROM fits, range(10) t(i);
----
expected lower, median

statement error
SELECT duckboost_calibrate_interval(lo, med, hi, i / 100.0, i, [0.0]) FROM fits, range(1, 11) t(i);
----
constant within a calibration group

statement error
SELECT duckboost_calibrate_interval(lo, med, hi, 'NaN'::DOUBLE, i, [0.0]) FROM fits, range(10) t(i);
----
alpha must be strictly between

statement error
SELECT duckboost_calibrate_interval(lo, med, hi, 0.1, 'NaN'::DOUBLE, [0.0]) FROM fits;
----
calibration targets and scores must be finite

# Force crossing by fitting separate constants. Predictions (5,10,2) sort to
# (2,5,10); y=3 gives a signed correction of -1 and a final band [3,9].
statement ok
CREATE TABLE crossed AS
WITH q AS (
	SELECT duckboost_train(5, [0.0], MAP {'objective':'quantile', 'quantile_alpha':'0.05'}) AS lo,
	       duckboost_train(10, [0.0], MAP {'objective':'quantile', 'quantile_alpha':'0.5'}) AS med,
	       duckboost_train(2, [0.0], MAP {'objective':'quantile', 'quantile_alpha':'0.95'}) AS hi
)
SELECT duckboost_calibrate_interval(lo, med, hi, 0.1, 3, [1.0]) AS model FROM q, range(10);

restart

require duckboost

query RRR
SELECT b.lower, b.median, b.upper FROM
(SELECT duckboost_predict_interval(model, [2.0]) AS b FROM artifacts);
----
-10.0	0.0	10.0

query RRR
SELECT b.lower, b.median, b.upper FROM
(SELECT duckboost_predict_interval(model, [2.0]) AS b FROM crossed);
----
3.0	5.0	9.0

statement ok
CREATE TABLE probes AS SELECT i AS id, i % 3 AS x FROM range(1, 6) t(i)
UNION ALL SELECT 0, NULL;

statement ok
SET VARIABLE interval_sql = (SELECT duckboost_interval_to_sql(model, 'probes', ['x'], ['id']) FROM crossed);

query I
WITH actual AS (SELECT * FROM query(getvariable('interval_sql'))),
expected AS (SELECT id, duckboost_predict_interval(model, [x]) AS b FROM probes, crossed)
SELECT count(*) = 6 AND bool_and(actual.lower = b.lower AND actual.median = b.median AND actual.upper = b.upper)
FROM actual JOIN expected USING (id);
----
true

# Strong calibration contraction can give an empty set on a different feature value.
# The calibration rows at x=0 have predictions (0,5,10) and signed score -5.
# The narrower band at x=1 is empty after subtracting that magnitude from both sides.
statement ok
CREATE TABLE narrow AS
WITH data(x, yl, ym, yu) AS (VALUES (0,0,5,10), (1,5,5,5)), q AS (
    SELECT duckboost_train(yl, [x], MAP {'objective':'quantile', 'quantile_alpha':'0.05',
               'n_estimators':'1', 'max_depth':'1', 'learning_rate':'1'}) AS lo,
           duckboost_train(ym, [x], MAP {'objective':'quantile', 'quantile_alpha':'0.5',
               'n_estimators':'1', 'max_depth':'1', 'learning_rate':'1'}) AS med,
           duckboost_train(yu, [x], MAP {'objective':'quantile', 'quantile_alpha':'0.95',
               'n_estimators':'1', 'max_depth':'1', 'learning_rate':'1'}) AS hi FROM data
)
SELECT duckboost_calibrate_interval(lo, med, hi, 0.1, 5, [0.0]) AS model FROM q, range(10);

query III
SELECT b.lower > b.upper, b.median = 5, model LIKE '%"correction":-5,%' FROM
(SELECT model, duckboost_predict_interval(model, [1.0]) AS b FROM narrow);
----
true	true	true

statement ok
SET default_order = 'DESC';

statement ok
SET VARIABLE narrow_sql = (SELECT duckboost_interval_to_sql(model, 'probes', ['x'], ['id']) FROM narrow);

query I
WITH exported AS (SELECT * FROM query(getvariable('narrow_sql'))),
native AS (SELECT id, duckboost_predict_interval(model, [x]) AS b FROM narrow, probes)
SELECT count_if(lower > upper) > 0 AND bool_and(lower = b.lower AND median = b.median AND upper = b.upper)
FROM exported JOIN native USING (id);
----
true

statement ok
RESET default_order;

# A NULL model or feature list propagates; NULL inside a feature list follows tree missing routing.
query I
SELECT count(b) = 1 FROM (
    SELECT duckboost_predict_interval(CASE WHEN i = 1 THEN NULL ELSE model END,
        CASE WHEN i = 2 THEN NULL ELSE [NULL::DOUBLE] END) AS b FROM narrow, range(3) t(i)
);
----
true

query I
SELECT count(q) = 1 FROM (SELECT duckboost_interval_to_sql(model, 'probes', ['x'],
    CASE WHEN i = 0 THEN NULL ELSE ['id'] END) AS q FROM narrow, range(2) t(i));
----
true

statement error
SELECT duckboost_calibrate_interval(lo, med, hi, 0.1, NULL, [1.0]) FROM fits;
----
must not be NULL

statement error
SELECT duckboost_predict_interval(replace(model, '"correction":10,', '"correction":1e999,'), [0.0]) FROM artifacts;
----
expected a format 3 calibrated interval model

statement error
SELECT duckboost_interval_to_sql(replace(model, '"base_score":0,', '"base_score":1e999,'), 'probes', ['x'])
FROM artifacts;
----
interval fit parameters must be finite

statement error
SELECT duckboost_predict_interval(replace(model, '"artifact_type":', '"alpha":0.5,"artifact_type":'), [0.0])
FROM artifacts;
----
duplicate interval field
