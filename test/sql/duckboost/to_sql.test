# name: test/sql/duckboost/to_sql.test
# description: duckboost SQL export matches in-process predictions
# group: [duckboost]

require duckboost

statement ok
CREATE TABLE train AS
SELECT
	i::DOUBLE AS x1,
	((i * 3) % 5)::DOUBLE AS x2,
	(1.5 * i - 0.25 * ((i * 3) % 5))::DOUBLE AS y
FROM range(30) t(i);

statement ok
CREATE TABLE score AS
SELECT * FROM train WHERE x1 >= 20;

statement ok
CREATE TABLE models AS
SELECT duckboost_train(
	y,
	[x1, x2],
	MAP {
		'backend': 'reference',
		'task': 'regression',
		'n_estimators': '8',
		'max_depth': '2',
		'learning_rate': '0.3',
		'feature_names': 'x1,x2'
	}
) AS model
FROM train;

statement ok
CREATE TABLE native_pred AS
SELECT
	s.x1,
	s.x2,
	duckboost_predict(m.model, [s.x1, s.x2]) AS pred
FROM score s, models m;

statement ok
CREATE TABLE sql_text AS
SELECT duckboost_to_sql(
	model,
	'score',
	['x1', 'x2'],
	MAP {'separate_trees': 'true', 'prediction_alias': 'pred'}
) AS q
FROM models;

# Exported SQL should mention separate tree columns
query I
SELECT q ILIKE '%tree_0%' AND q ILIKE '%_duckboost_trees%' FROM sql_text;
----
true

statement ok
SET VARIABLE duckboost_sql = (SELECT q FROM sql_text);

statement ok
CREATE TABLE sql_pred AS
SELECT * FROM query(getvariable('duckboost_sql'));

# Max absolute difference between native predict and SQL export should be tiny
query I
SELECT max(abs(n.pred - s.pred)) < 1e-8
FROM (
	SELECT pred, row_number() OVER (ORDER BY x1, x2) AS rn FROM native_pred
) n
JOIN (
	SELECT pred, row_number() OVER () AS rn FROM sql_pred
) s USING (rn);
----
true

# Compact (non-separated) SQL export also works
query I
SELECT duckboost_to_sql(
	(SELECT model FROM models),
	'score',
	['x1', 'x2'],
	MAP {'separate_trees': 'false'}
) ILIKE '%CASE WHEN%';
----
true

# keep_columns preserves identity columns for deployable joining
statement ok
CREATE TABLE score_with_id AS
SELECT row_number() OVER (ORDER BY x1, x2) AS id, x1, x2 FROM score;

statement ok
SET VARIABLE keep_sql = (
	SELECT duckboost_to_sql(
		model,
		'score_with_id',
		['x1', 'x2'],
		MAP {'separate_trees': 'true', 'prediction_alias': 'pred', 'keep_columns': 'id'}
	)
	FROM models
);

statement ok
CREATE TABLE keep_pred AS SELECT * FROM query(getvariable('keep_sql'));

query I
SELECT bool_and(abs(n.pred - k.pred) < 1e-8)
FROM (
	SELECT id, duckboost_predict(m.model, [s.x1, s.x2]) AS pred
	FROM score_with_id s, models m
) n
JOIN keep_pred k USING (id);
----
true

# Binary/multiclass proba columns match predict_proba
statement ok
CREATE TABLE bin_train AS
SELECT i::DOUBLE AS x, (i > 10)::DOUBLE AS y FROM range(20) t(i);

statement ok
CREATE TABLE bin_models AS
SELECT duckboost_train(y, [x], MAP {'task': 'binary', 'n_estimators': '5', 'feature_names': 'x'}) AS model
FROM bin_train;

statement ok
CREATE TABLE bin_score AS SELECT i AS id, i::DOUBLE AS x FROM range(20) t(i);

statement ok
SET VARIABLE bin_proba_sql = (
	SELECT duckboost_to_sql(
		model, 'bin_score', ['x'],
		MAP {'separate_trees': 'false', 'prediction_alias': 'pred', 'keep_columns': 'id', 'proba': 'true'}
	)
	FROM bin_models
);

statement ok
CREATE TABLE bin_sql_pred AS SELECT * FROM query(getvariable('bin_proba_sql'));

query I
SELECT bool_and(
	abs(list_extract(p, 1) - s.proba_0) < 1e-12 AND
	abs(list_extract(p, 2) - s.proba_1) < 1e-12 AND
	abs(duckboost_predict(m.model, [b.x]) - s.pred) < 1e-12
)
FROM bin_score b, bin_models m, bin_sql_pred s,
LATERAL (SELECT duckboost_predict_proba(m.model, [b.x]) AS p)
WHERE b.id = s.id;
----
true

statement error
SELECT duckboost_to_sql(
	(SELECT model FROM models), 'score', ['x1', 'x2'], MAP {'proba': 'true'}
);
----
<REGEX>:.*proba requires a binary or multiclass model.*
