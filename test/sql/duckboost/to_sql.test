# name: test/sql/duckboost/to_sql.test
# description: duckboost SQL export matches in-process predictions
# group: [duckboost]

require duckboost

statement ok
CREATE TABLE train AS
SELECT
	i::DOUBLE AS x1,
	((i * 3) % 5)::DOUBLE AS x2,
	(1.5 * i - 0.25 * ((i * 3) % 5))::DOUBLE AS y
FROM range(30) t(i);

statement ok
CREATE TABLE score AS
SELECT * FROM train WHERE x1 >= 20;

statement ok
CREATE TABLE models AS
SELECT duckboost_train(
	y,
	[x1, x2],
	MAP {
		'backend': 'reference',
		'task': 'regression',
		'n_estimators': '8',
		'max_depth': '2',
		'learning_rate': '0.3',
		'feature_names': 'x1,x2'
	}
) AS model
FROM train;

statement ok
CREATE TABLE native_pred AS
SELECT
	s.x1,
	s.x2,
	duckboost_predict(m.model, [s.x1, s.x2]) AS pred
FROM score s, models m;

statement ok
CREATE TABLE sql_text AS
SELECT duckboost_to_sql(
	model,
	'score',
	['x1', 'x2'],
	MAP {'separate_trees': 'true', 'prediction_alias': 'pred'}
) AS q
FROM models;

# Exported SQL should mention separate tree columns
query I
SELECT q ILIKE '%tree_0%' AND q ILIKE '%_duckboost_trees%' FROM sql_text;
----
true

statement ok
SET VARIABLE duckboost_sql = (SELECT q FROM sql_text);

statement ok
CREATE TABLE sql_pred AS
SELECT * FROM query(getvariable('duckboost_sql'));

# Max absolute difference between native predict and SQL export should be tiny
query I
SELECT max(abs(n.pred - s.pred)) < 1e-8
FROM (
	SELECT pred, row_number() OVER (ORDER BY x1, x2) AS rn FROM native_pred
) n
JOIN (
	SELECT pred, row_number() OVER () AS rn FROM sql_pred
) s USING (rn);
----
true

# Compact (non-separated) SQL export also works
query I
SELECT duckboost_to_sql(
	(SELECT model FROM models),
	'score',
	['x1', 'x2'],
	MAP {'separate_trees': 'false'}
) ILIKE '%CASE WHEN%';
----
true

# keep_columns preserves identity columns for deployable joining
statement ok
CREATE TABLE score_with_id AS
SELECT row_number() OVER (ORDER BY x1, x2) AS id, x1, x2 FROM score;

statement ok
SET VARIABLE keep_sql = (
	SELECT duckboost_to_sql(
		model,
		'score_with_id',
		['x1', 'x2'],
		MAP {'separate_trees': 'true', 'prediction_alias': 'pred', 'keep_columns': 'id'}
	)
	FROM models
);

statement ok
CREATE TABLE keep_pred AS SELECT * FROM query(getvariable('keep_sql'));

query I
SELECT bool_and(abs(n.pred - k.pred) < 1e-8)
FROM (
	SELECT id, duckboost_predict(m.model, [s.x1, s.x2]) AS pred
	FROM score_with_id s, models m
) n
JOIN keep_pred k USING (id);
----
true

# Binary/multiclass proba columns match predict_proba
statement ok
CREATE TABLE bin_train AS
SELECT i::DOUBLE AS x, (i > 10)::DOUBLE AS y FROM range(20) t(i);

statement ok
CREATE TABLE bin_models AS
SELECT duckboost_train(y, [x], MAP {'task': 'binary', 'n_estimators': '5', 'feature_names': 'x'}) AS model
FROM bin_train;

statement ok
CREATE TABLE bin_score AS SELECT i AS id, i::DOUBLE AS x FROM range(20) t(i);

statement ok
SET VARIABLE bin_proba_sql = (
	SELECT duckboost_to_sql(
		model, 'bin_score', ['x'],
		MAP {'separate_trees': 'false', 'prediction_alias': 'pred', 'keep_columns': 'id', 'proba': 'true'}
	)
	FROM bin_models
);

statement ok
CREATE TABLE bin_sql_pred AS SELECT * FROM query(getvariable('bin_proba_sql'));

query I
SELECT bool_and(
	abs(list_extract(p, 1) - s.proba_0) < 1e-12 AND
	abs(list_extract(p, 2) - s.proba_1) < 1e-12 AND
	abs(duckboost_predict(m.model, [b.x]) - s.pred) < 1e-12
)
FROM bin_score b, bin_models m, bin_sql_pred s,
LATERAL (SELECT duckboost_predict_proba(m.model, [b.x]) AS p)
WHERE b.id = s.id;
----
true

statement error
SELECT duckboost_to_sql(
	(SELECT model FROM models), 'score', ['x1', 'x2'], MAP {'proba': 'true'}
);
----
<REGEX>:.*proba requires a binary or multiclass model.*

# DuckDB 2.0 parses 17-digit decimal literals as DECIMAL. Large ensembles
# overflow DECIMAL(38, scale) (v0.0.4). Exported literals now use e0 so they
# bind as DOUBLE — the same arithmetic duckboost_predict uses.
query I
SELECT duckboost_to_sql(
	(SELECT model FROM models),
	'score',
	['x1', 'x2'],
	MAP {'separate_trees': 'true', 'prediction_alias': 'pred'}
) ILIKE '%0.29999999999999999e0%';
----
true

statement ok
CREATE TABLE large_train AS
WITH u AS (
	SELECT i AS id,
		(hash(i * 10 + 1) % 1000000) / 1000000.0 AS x1,
		(hash(i * 10 + 2) % 1000000) / 1000000.0 AS x2,
		(hash(i * 10 + 3) % 1000000) / 1000000.0 AS x3,
		(hash(i * 10 + 4) % 1000000) / 1000000.0 AS x4,
		(hash(i * 10 + 5) % 1000000) / 1000000.0 AS e1,
		(hash(i * 10 + 6) % 1000000) / 1000000.0 AS e2
	FROM range(800) t(i)
)
SELECT id, x1, x2, x3, x4,
	(10 * x1 + 6 * sin(6 * x2) + 8 * (x3 > 0.5)::INT * x4 - 4 * x1 * x2
		+ 2.0 * (e1 + e2 - 1))::DOUBLE AS y
FROM u;

statement ok
CREATE TABLE large_models AS
SELECT duckboost_train(
	y, [x1, x2, x3, x4],
	MAP {
		'backend': 'native',
		'task': 'regression',
		'n_estimators': '80',
		'max_depth': '4',
		'learning_rate': '0.1',
		'min_samples_leaf': '5',
		'seed': '42',
		'feature_names': 'x1,x2,x3,x4'
	}
) AS model
FROM large_train;

statement ok
CREATE VIEW large_score AS
SELECT id, x1, x2, x3, x4 FROM large_train WHERE id % 10 = 0;

statement ok
SET VARIABLE large_sql = (
	SELECT duckboost_to_sql(
		model, 'large_score', ['x1', 'x2', 'x3', 'x4'],
		MAP {'separate_trees': 'true', 'prediction_alias': 'pred', 'keep_columns': 'id'}
	)
	FROM large_models
);

# Exported text must not leave a 17-digit decimal without an exponent.
query I
SELECT getvariable('large_sql') SIMILAR TO '%[0-9]\.[0-9]{10,}[^0-9eE.]%';
----
false

statement ok
CREATE TABLE large_sql_pred AS FROM query(getvariable('large_sql'));

query I
SELECT typeof(pred) FROM large_sql_pred LIMIT 1;
----
DOUBLE

query I
SELECT bool_and(abs(n.pred - s.pred) < 1e-12)
FROM (
	SELECT id, duckboost_predict(m.model, [t.x1, t.x2, t.x3, t.x4]) AS pred
	FROM large_score t, large_models m
) n
JOIN large_sql_pred s USING (id);
----
true

# A complete depth-eight tree has 256 distinct leaves. Binary probability columns
# must also share the compact score, or each marker would occur three times.
statement ok
CREATE TABLE marked_tree AS
SELECT '{"duckboost_version":1,"n_features":1,"task":"binary","base_score":0,"learning_rate":1,"trees":[{"nodes":[' ||
       string_agg(CASE WHEN i < 255 THEN
           printf('{"is_leaf":false,"feature":0,"threshold":1,"left":%d,"right":%d}', 2*i+1, 2*i+2)
           ELSE printf('{"is_leaf":true,"value":%d}', 100000+i) END, ',' ORDER BY i) || ']}]}' AS model
FROM range(511) t(i);

query I
WITH exported AS (
    SELECT duckboost_to_sql(model, 'score', ['x'], MAP {'separate_trees':'false','proba':'true'}) AS q
    FROM marked_tree
)
SELECT bool_and(len(string_split(q, (100000+i)::VARCHAR || 'e0')) = 2) FROM exported, range(255,511) t(i);
----
true

# Match by ID for every missing/threshold mode, including LightGBM's tiny
# floats, and retain original columns with compact and separated probabilities.
statement ok
CREATE TABLE route_score(id, x) AS
VALUES (1,NULL::DOUBLE),(2,'NaN'::DOUBLE),(3,0.0),(4,0.5),(5,-2.0),(6,2.0),
       (7,1e-36),(8,-1e-36),(9,1.0),(10,-1.0),(11,3.9);

statement ok
CREATE TABLE route_models AS
SELECT parse_filename(filename, true) AS fixture,
       replace(replace(duckboost_import('lightgbm', content), '"task":"regression"', '"task":"binary"'),
               '"learning_rate":1,', '"learning_rate":0.01,') AS model
FROM read_text(['test/sql/duckboost/data/lgb_numeric_missing.txt',
                'test/sql/duckboost/data/lgb_categorical.txt',
                'test/sql/duckboost/data/lgb_categorical_single.txt']);

foreach fixture lgb_numeric_missing lgb_categorical lgb_categorical_single

foreach mode false true

statement ok
SET VARIABLE routes = (
    SELECT duckboost_to_sql(model, 'route_score', ['x','x'],
                            MAP {'separate_trees':'{mode}','keep_columns':'*','proba':'true'})
    FROM route_models WHERE fixture = '{fixture}'
);

query I
SELECT count(*) = 11 AND bool_and(abs(e.prediction - p[2]) < 1e-12 AND
    abs(e.proba_1 - p[2]) < 1e-12 AND abs(e.proba_0 - p[1]) < 1e-12)
FROM route_score s JOIN query(getvariable('routes')) e USING (id), route_models m,
LATERAL (SELECT duckboost_predict_proba(m.model,[s.x,s.x]) AS p) WHERE fixture = '{fixture}';
----
true

endloop

endloop

# A passthrough column can share the internal source alias.
statement ok
CREATE TABLE named_source AS SELECT id AS __duckboost_src, x FROM bin_score;

statement ok
SET VARIABLE named_source_sql = (
    SELECT duckboost_to_sql(model, 'named_source', ['x'], MAP {'separate_trees':'false','keep_columns':'*','proba':'true'})
    FROM bin_models
);

query I
SELECT count(*) = 20 AND bool_and(abs(p.prediction - duckboost_predict(m.model,[p.x])) < 1e-12)
    AND count(DISTINCT p.__duckboost_src) = 20
FROM query(getvariable('named_source_sql')) p, bin_models m;
----
true
