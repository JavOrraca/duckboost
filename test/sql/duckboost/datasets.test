# name: test/sql/duckboost/datasets.test
# description: bundled iris and palmerpenguins CSVs load and train
# group: [duckboost]

require duckboost

statement ok
CREATE TABLE iris AS FROM read_csv('data/iris.csv');

query TT
SELECT column_name, column_type FROM (DESCRIBE iris);
----
sepal_length	DOUBLE
sepal_width	DOUBLE
petal_length	DOUBLE
petal_width	DOUBLE
species	VARCHAR

# Per-species counts and means match R's datasets::iris
query IRRRR
SELECT
	count(*),
	round(avg(sepal_length), 3),
	round(avg(sepal_width), 3),
	round(avg(petal_length), 3),
	round(avg(petal_width), 3)
FROM iris
GROUP BY species
ORDER BY species;
----
50	5.006	3.428	1.462	0.246
50	5.936	2.770	4.260	1.326
50	6.588	2.974	5.552	2.026

# R's corrected rows 35 and 38 (the UCI copy differs here)
query RRRR
SELECT sepal_length, sepal_width, petal_length, petal_width
FROM (SELECT *, row_number() OVER () AS rn FROM iris)
WHERE rn IN (35, 38)
ORDER BY rn;
----
4.9	3.1	1.5	0.2
4.9	3.6	1.4	0.1

statement ok
CREATE TABLE iris_binary AS
SELECT
	(species = 'virginica')::DOUBLE AS y,
	[sepal_length, sepal_width, petal_length, petal_width] AS features
FROM iris
WHERE species <> 'setosa';

statement ok
CREATE TABLE iris_model AS
SELECT duckboost_train(y, features, MAP {'task': 'binary', 'n_estimators': '30', 'max_depth': '2', 'learning_rate': '0.3'}) AS model
FROM iris_binary;

query I
SELECT duckboost_evaluate_agg(model, y, features, MAP {'metric': 'accuracy'}) > 0.95
FROM iris_model, iris_binary;
----
true

statement ok
CREATE TABLE penguins AS FROM read_csv('data/penguins.csv', nullstr = 'NA');

query TT
SELECT column_name, column_type FROM (DESCRIBE penguins);
----
species	VARCHAR
island	VARCHAR
bill_length_mm	DOUBLE
bill_depth_mm	DOUBLE
flipper_length_mm	BIGINT
body_mass_g	BIGINT
sex	VARCHAR
year	BIGINT

query IIII
SELECT count(*), count(bill_length_mm), count(sex), count(*) FILTER (WHERE sex IS NOT NULL AND bill_length_mm IS NOT NULL)
FROM penguins;
----
344	342	333	333

query TI
SELECT species, count(*) FROM penguins GROUP BY species ORDER BY species;
----
Adelie	152
Chinstrap	68
Gentoo	124

statement ok
CREATE TABLE penguins_mass AS
SELECT
	body_mass_g::DOUBLE AS y,
	[
		bill_length_mm, bill_depth_mm, flipper_length_mm, (sex = 'male')::DOUBLE,
		(species = 'Adelie')::DOUBLE, (species = 'Chinstrap')::DOUBLE, (species = 'Gentoo')::DOUBLE
	] AS features
FROM penguins
WHERE sex IS NOT NULL AND bill_length_mm IS NOT NULL;

statement ok
CREATE TABLE penguins_model AS
SELECT duckboost_train(y, features, MAP {'n_estimators': '100', 'max_depth': '3', 'learning_rate': '0.1'}) AS model
FROM penguins_mass;

# Training RMSE well below the ~800 g standard deviation of body mass
query I
SELECT duckboost_evaluate_agg(model, y, features, MAP {'metric': 'rmse'}) < 300
FROM penguins_model, penguins_mass;
----
true
